  "components": {
    "schemas": {
      "IntakePublish": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "key",
          "baseReleaseId",
          "sourceEvidenceVersion",
          "title",
          "summary",
          "confirmed"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          },
          "baseReleaseId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceEvidenceVersion": {
            "$ref": "#/components/schemas/IntakeVersion"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "description": "明确的本次发布意图；桌面仅在 Main 原生二次确认后设置。不能替代服务端权限/版本/来源/质量复核，也不能证明任意第三方调用者弹过窗。"
          }
        }
      },
      "IntakeRollback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "baseReleaseId",
          "targetReleaseId",
          "impactDigest",
          "rollbackPlanId",
          "confirmed"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "baseReleaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "targetReleaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "impactDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "rollbackPlanId": {
            "$ref": "#/components/schemas/IntakeId"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "description": "明确的本次发布意图；桌面仅在 Main 原生二次确认后设置。不能替代服务端权限/版本/来源/质量复核，也不能证明任意第三方调用者弹过窗。"
          }
        }
      },
      "IntakeCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "sourceId",
          "state",
          "readinessReasons",
          "sourceEvidenceVersion",
          "approvalEvidenceVersion",
          "revocationGeneration",
          "createdAt",
          "updatedAt",
          "publishedReleaseId",
          "publicationPolicy"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "enum": [
              "awaiting-evidence",
              "ready",
              "publishing",
              "published",
              "cancelled",
              "invalidated"
            ]
          },
          "readinessReasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 0,
            "maxItems": 32
          },
          "sourceEvidenceVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "approvalEvidenceVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revocationGeneration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 35
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 35
          },
          "publishedReleaseId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "publicationPolicy": {
            "type": "string",
            "enum": [
              "approval-v1",
              "direct-v1"
            ],
            "description": "服务端冻结的候选发布政策。旧候选不可原地改成直发；须显式修订为新版本。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "publicationPolicy": {
                  "const": "direct-v1"
                }
              },
              "required": [
                "publicationPolicy"
              ]
            },
            "then": {
              "properties": {
                "approvalEvidenceVersion": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
