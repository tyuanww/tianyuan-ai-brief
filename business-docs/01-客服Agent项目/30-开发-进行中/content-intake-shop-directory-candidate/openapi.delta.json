{
  "failureReasons": [
    "SHOP_DIRECTORY_CURSOR",
    "SHOP_DIRECTORY_SESSION",
    "SHOP_DISPLAY_MISSING",
    "SHOP_DIRECTORY_CHANGED",
    "SHOP_DIRECTORY_EXPIRED"
  ],
  "paths": {
    "/v1/intake/shop-directory": {
      "get": {
        "operationId": "listIntakeShopDirectory",
        "summary": "分页读取当前主体可查询店铺的正式显示名",
        "description": "只读店铺目录。认证主体和产品会话只来自 ProductSession，调用方不能提交 principal、tenant、app 或店铺名单。服务端先按既有 query 授权谓词得到店铺集合，再附上目录里的当前显示名；品牌级 shopId=null 不展开全公司店铺，显示名不授予 query 或其他业务动作。查询和复制仍使用 shopId。displayName 非空且最多 256 个字符，重名保留各自 shopId。同一 tenant/app/shop 只有一条当前名称和 displayVersion，同店多个来源不能各带一个名称。任一有 query 资格的店铺缺少当前名称时整次 409，不返回其余店铺。limit 为 1–100，缺省 50。nextCursor 不含会话哈希，由服务端用独立私有签名 key 进行 HMAC，绑定主体、租户、应用、会话、每页数量、主体事实版本、撤销代际、完整目录修订、授权集合摘要、截止和本页边界；更名、撤权、新增或失去 query 资格、身份代际变化返回 409 SHOP_DIRECTORY_CHANGED，截止已过返回 409 SHOP_DIRECTORY_EXPIRED。两种失败都不返回条目，调用方必须丢弃已读页并从第一页重读，不能把新旧页拼成一份目录。畸形 cursor 或 limit 为 400 SHOP_DIRECTORY_CURSOR；篡改游标、换会话或改变 limit 均为 400 SHOP_DIRECTORY_CURSOR。名称不来自飞书通讯录字段。参见 18-P2店铺目录合同候选.md。",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页返回的 nextCursor。省略表示第一页。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "本页店铺数。缺省 50，最大 100。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "x-max-response-bytes": 131072,
        "x-required-intake-action": "query",
        "x-display-name-grants-business-action": false,
        "responses": {
          "200": {
            "description": "当前主体可查询店铺的一页显示名。Cache-Control: no-store。空集合表示当前没有 query 店铺，不是缺少名称。",
            "headers": {
              "Cache-Control": {
                "description": "含会话和授权截止的读取不得缓存。",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeShopDirectory"
                }
              }
            }
          },
          "400": {
            "description": "cursor 或 limit 不符合合同。reason=SHOP_DIRECTORY_CURSOR。不返回条目。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          },
          "401": {
            "description": "会话未认证或主体不存在。reason=SHOP_DIRECTORY_SESSION。不披露目录是否存在。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          },
          "403": {
            "description": "与具体店铺无关的全局能力拒绝。未授权店铺不使用 403 暴露存在性。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          },
          "409": {
            "description": "SHOP_DISPLAY_MISSING、SHOP_DIRECTORY_CHANGED 或 SHOP_DIRECTORY_EXPIRED。不返回任何店铺。调用方丢弃已读页；CHANGED 或 EXPIRED 后从第一页重读，MISSING 时不得用店铺编号代替名称。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IntakeShopDirectory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor",
          "validUntil"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntakeShopDisplay"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "maxLength": 35,
            "description": "本页与后续同一次目录读取共用的最早截止。它不是新的业务授权。"
          }
        }
      },
      "IntakeShopDisplay": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shopId",
          "displayName",
          "displayVersion"
        ],
        "properties": {
          "shopId": {
            "$ref": "#/components/schemas/IntakeId"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f\\u2028\\u2029](?:[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*[^\\s\\u0000-\\u001f\\u007f\\u2028\\u2029])?$"
          },
          "displayVersion": {
            "$ref": "#/components/schemas/IntakeVersion"
          }
        }
      }
    }
  }
}
