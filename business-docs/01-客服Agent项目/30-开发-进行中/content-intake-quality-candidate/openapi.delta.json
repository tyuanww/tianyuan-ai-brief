              }
            }
          },
          "429": {
            "description": "按 error.code / details.reason 采取规定恢复动作；不披露资源权限或存在性。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          },
          "500": {
            "description": "按 error.code / details.reason 采取规定恢复动作；不披露资源权限或存在性。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          },
          "503": {
            "description": "按 error.code / details.reason 采取规定恢复动作；不披露资源权限或存在性。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          },
          "413": {
            "description": "请求或持久检查集合超出字节预算；VALIDATION / FILE_LIMIT。整次拒绝，不留下部分结果；须缩短原因后使用新操作键提交。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeError"
                }
              }
            }
          }
        },
        "x-max-response-bytes": 65536
      }
    }
  },
  "components": {
    "schemas": {
      "IntakeQualityCheck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scriptId",
          "contentHash",
          "defect",
          "reason"
        ],
        "properties": {
          "scriptId": {
            "type": "string",
            "pattern": "^intake_[0-9a-f]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "defect": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
          }
        },
        "if": {
          "properties": {
            "defect": {
              "const": true
            }
          }
        },
        "then": {
          "properties": {
            "reason": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "description": "原因按 Unicode code point 计数；禁止 NUL 和未配对代理项。缺陷必须有非空白原因；单轮和请求还受字节预算约束。"
      },
      "IntakeQualityCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "key"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/components/schemas/IntakeId"
          },
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          }
        }
      },
      "IntakeQualitySubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "key",
          "phase",
          "checks"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/components/schemas/IntakeId"
          },
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          },
          "phase": {
            "type": "string",
            "enum": [
              "initial",
              "expanded"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntakeQualityCheck"
            },
            "minItems": 0,
            "maxItems": 5000
          }
        },
        "description": "完整阶段一次原子提交，scriptId 唯一且集合精确匹配服务端冻结样本；扩样原结果不可改。空集合仅在服务端阶段样本实际为空时合法。未知字段拒绝；不接受审核人、抽样参数或结论。"
      },
      "IntakeQualityPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policyVersion",
          "ordinaryCount",
          "mandatoryCount",
          "withdrawalCount",
          "initialTarget",
          "expandedTarget",
          "initialCount",
          "expandedCount",
          "seedHash",
          "populationManifestHash",
          "selectionManifestHash"
        ],
        "properties": {
          "policyVersion": {
            "type": "string",
            "const": "intake-quality-v1"
          },
          "ordinaryCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "mandatoryCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "withdrawalCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "initialTarget": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "expandedTarget": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "initialCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "expandedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "seedHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "populationManifestHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "selectionManifestHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "IntakeQualityAttribution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principalId",
          "factsVersion",
          "recordedAt"
        ],
        "properties": {
          "principalId": {
            "$ref": "#/components/schemas/IntakeId"
          },
          "factsVersion": {
            "$ref": "#/components/schemas/IntakeVersion"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 35
          }
        }
      },
      "IntakeQualityRound": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "reviewer",
          "checkedCount",
          "defectCount"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "initial",
              "expanded"
            ]
          },
          "reviewer": {
            "$ref": "#/components/schemas/IntakeQualityAttribution"
          },
          "checkedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "defectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        }
      },
      "IntakeQualityStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "viewHash",
          "state",
          "plan",
          "frozen",
          "rounds"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          },
          "viewHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "state": {
            "type": "string",
            "enum": [
              "not_frozen",
              "initial_required",
              "expansion_required",
              "passed",
              "revision_required",
              "blocked"
            ]
          },
          "plan": {
            "$ref": "#/components/schemas/IntakeQualityPlan"
          },
          "frozen": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IntakeQualityAttribution"
              },
              {
                "type": "null"
              }
            ]
          },
          "rounds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntakeQualityRound"
            },
            "minItems": 0,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "phase": {
                      "const": "initial"
                    }
                  },
                  "required": [
                    "phase"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "phase": {
                      "const": "expanded"
                    }
                  },
                  "required": [
                    "phase"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            ]
          }
        },
        "if": {
          "properties": {
            "state": {
              "const": "not_frozen"
            }
          }
        },
        "then": {
          "properties": {
            "frozen": {
              "type": "null"
            },
            "rounds": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "else": {
          "properties": {
            "frozen": {
              "type": "object"
            }
          }
        },
        "description": "当前重新授权的有界摘要，not_frozen 的 plan 仅是服务端预览。viewHash 绑定 key/plan/state/frozen/rounds（不含自己）的规范 JSON SHA-256。passed 不是组织审批或发布许可。",
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "initial_required"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "rounds": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "expansion_required"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "rounds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "contains": {
                    "type": "object",
                    "properties": {
                      "phase": {
                        "const": "initial"
                      }
                    },
                    "required": [
                      "phase"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "passed",
                    "revision_required",
                    "blocked"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "rounds": {
                  "type": "array",
                  "minItems": 1,
                  "contains": {
                    "type": "object",
                    "properties": {
                      "phase": {
                        "const": "initial"
                      }
                    },
                    "required": [
                      "phase"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "IntakeQualitySample": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scriptId",
          "contentHash",
          "mandatory",
          "entry",
          "check"
        ],
        "properties": {
          "scriptId": {
            "type": "string",
            "pattern": "^intake_[0-9a-f]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "mandatory": {
            "type": "boolean"
          },
          "entry": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IntakeEntry"
              },
              {
                "type": "object",
                "properties": {
                  "operation": {
                    "const": "upsert"
                  }
                }
              }
            ]
          },
          "check": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IntakeQualityCheck"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "IntakeQualitySamplePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "viewHash",
          "phase",
          "selectionManifestHash",
          "items",
          "nextCursor"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          },
          "viewHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "phase": {
            "type": "string",
            "enum": [
              "initial",
              "expanded"
            ]
          },
          "selectionManifestHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntakeQualitySample"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          }
        },
        "description": "按服务端冻结抽样顺序分页；entry 完整保真且只可 upsert，check 的 ID/hash 必须与所在 sample 一致。每页 8 MiB 上限可提前截页，但不得截断单条、漏行或返回有 nextCursor 的空页。",
        "if": {
          "properties": {
            "nextCursor": {
              "type": "string"
            }
          }
        },
        "then": {
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      },
      "IntakeQualityReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "action",
          "key",
          "state",
          "phase"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/components/schemas/IntakeId"
          },
          "action": {
            "type": "string",
            "enum": [
              "quality-freeze",
              "quality-check"
            ]
          },
          "key": {
            "$ref": "#/components/schemas/IntakeCandidateKey"
          },
          "state": {
            "type": "string",
            "enum": [
              "initial_required",
              "expansion_required",
              "passed",
              "revision_required",
              "blocked"
            ]
          },
          "phase": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "initial",
                  "expanded"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "if": {
          "properties": {
            "action": {
              "const": "quality-freeze"
            }
          }
        },
        "then": {
          "properties": {
            "phase": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "initial",
                "expanded"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "expansion_required",
                "passed",
                "revision_required",
                "blocked"
              ]
            }
          }
        },
        "description": "永久操作的精简历史结果，不含正文、逐条原因、权限或新的使用资格。只有当前有效会话的原主体能恢复；不将历史 state 当成当前状态。",
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "expanded"
                }
              }
            },
            "then": {
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "revision_required",
                    "blocked"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
